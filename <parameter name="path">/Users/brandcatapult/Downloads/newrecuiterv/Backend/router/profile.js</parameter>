<parameter name="content">const express = require('express');
const router = express.Router();
const jwt = require('jsonwebtoken');
const recruiterModel = require('../model_fire/recruiterF');
const candidateModel = require('../model_fire/candidateF');

// Middleware to check authentication
function authMiddleware(req, res, next) {
  const token = req.cookies.__session;

  if (!token) {
    return res.status(401).json({ success: false, message: "Unauthorized - No token found" });
  }

  try {
    const decoded = jwt.verify(token, process.env.SECKEY);
    req.user = decoded;
    next();
  } catch (err) {
    return res.status(403).json({ success: false, message: "Invalid or expired token" });
  }
}

/**
 * GET /api/profile/recruiter/:id
 * Get recruiter profile by ID
 */
router.get('/recruiter/:id', authMiddleware, async (req, res) => {
  try {
    const { id } = req.params;
    
    // Find recruiter by ID
    let recruiter = null;
    
    // Try to find by document ID first
    try {
      const recruiterDoc = await recruiterModel.getRecruiterById(id);
      if (recruiterDoc) {
        recruiter = recruiterDoc;
      }
    } catch (err) {
      // If not found by ID, try by email
      recruiter = await recruiterModel.findRecruiterByEmail(id);
    }
    
    // If still not found, try email as ID
    if (!recruiter) {
      recruiter = await recruiterModel.findRecruiterByEmail(id);
    }

    if (!recruiter) {
      return res.status(404).json({
        success: false,
        message: "Recruiter not found"
      });
    }

    // Get candidate count for this recruiter
    let totalCandidates = 0;
    try {
      totalCandidates = await candidateModel.getRecruiterCandidateCount(recruiter.email || recruiter.emailAddress);
    } catch (countError) {
      console.warn("Could not get candidate count:", countError.message);
    }

    // Calculate profile completion
    const profileCompletion = calculateProfileCompletion(recruiter);

    // Build response
    const profileData = {
      id: recruiter.id || recruiter.recruiterId,
      name: recruiter.name || recruiter.firstName || 'Unknown',
      email: recruiter.email || recruiter.emailAddress,
      phone: recruiter.phone || '',
      location: recruiter.location || '',
      country: recruiter.country || '',
      bio: recruiter.bio || '',
      currentTitle: recruiter.currentTitle || '',
      currentCompany: recruiter.currentCompany || '',
      specialization: recruiter.specialization || '',
      targetIndustries: recruiter.targetIndustries || [],
      recruitmentMethods: recruiter.recruitmentMethods || [],
      yearsOfExperience: recruiter.yearsOfExperience || 0,
      linkedin: recruiter.linkedin || '',
      twitter: recruiter.twitter || '',
      website: recruiter.website || '',
      skills: recruiter.skills || [],
      workExperience: recruiter.workExperience || [],
      education: recruiter.education || [],
      hasResume: recruiter.hasResume || false,
      resumeFileName: recruiter.resumeFileName || '',
      profileCompletion: profileCompletion,
      totalCandidates: totalCandidates,
      // Plan info
      planType: recruiter.planType,
      planExpiryDate: recruiter.planExpiryDate
    };

    res.status(200).json({
      success: true,
      data: profileData
    });

  } catch (error) {
    console.error("Error getting recruiter profile:", error);
    res.status(500).json({
      success: false,
      message: error.message || "Failed to get recruiter profile"
    });
  }
});

/**
 * Calculate profile completion percentage
 */
function calculateProfileCompletion(recruiter) {
  const fields = [
    'name',
    'phone',
    'location',
    'country',
    'bio',
    'currentTitle',
    'currentCompany',
    'specialization',
    'targetIndustries',
    'recruitmentMethods',
    'yearsOfExperience',
    'linkedin',
    'twitter',
    'website',
    'skills',
    'workExperience',
    'education',
    'hasResume'
  ];

  let completed = 0;
  const requiredFields = ['name', 'email'];

  // Check required fields first
  for (const field of requiredFields) {
    if (recruiter[field] && recruiter[field].toString().trim() !== '') {
      completed += 2; // Required fields count more
    }
  }

  // Check optional fields
  for (const field of fields) {
    if (recruiter[field]) {
      if (Array.isArray(recruiter[field])) {
        if (recruiter[field].length > 0) {
          completed += 1;
        }
      } else if (typeof recruiter[field] === 'string') {
        if (recruiter[field].trim() !== '') {
          completed += 1;
        }
      } else if (typeof recruiter[field] === 'number') {
        completed += 1;
      } else if (typeof recruiter[field] === 'boolean') {
        if (recruiter[field]) {
          completed += 1;
        }
      }
    }
  }

  // Cap at 100
  return Math.min(100, Math.round(completed * 2.5));
}

/**
 * GET /api/profile/recruiter/stats/:email
 * Get recruiter statistics
 */
router.get('/recruiter/stats/:email', authMiddleware, async (req, res) => {
  try {
    const { email } = req.params;

    const recruiter = await recruiterModel.findRecruiterByEmail(email);

    if (!recruiter) {
      return res.status(404).json({
        success: false,
        message: "Recruiter not found"
      });
    }

    // Get candidate count
    let totalCandidates = 0;
    let activeCandidates = 0;
    let hiredCandidates = 0;

    try {
      totalCandidates = await candidateModel.getRecruiterCandidateCount(email);
      activeCandidates = await candidateModel.getRecruiterActiveCandidateCount(email);
      hiredCandidates = await candidateModel.getRecruiterHiredCandidateCount(email);
    } catch (countError) {
      console.warn("Could not get candidate counts:", countError.message);
    }

    res.status(200).json({
      success: true,
      data: {
        recruiterId: recruiter.id || recruiter.recruiterId,
        name: recruiter.name || recruiter.firstName || 'Unknown',
        email: email,
        totalCandidates: totalCandidates,
        activeCandidates: activeCandidates,
        hiredCandidates: hiredCandidates,
        planType: recruiter.planType,
        planExpiryDate: recruiter.planExpiryDate
      }
    });

  } catch (error) {
    console.error("Error getting recruiter stats:", error);
    res.status(500).json({
      success: false,
      message: error.message || "Failed to get recruiter stats"
    });
  }
});

module.exports = router;
