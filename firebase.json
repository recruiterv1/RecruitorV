{
  "firestore": {
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "Frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/position/**",
        "function": "api"
      },
      {
        "source": "/dash_view/**",
        "function": "api"
      },
      {
        "source": "/auth/**",
        "function": "api"
      },
      {
        "source": "/clientspoc/**",
        "function": "api"
      },
      {
        "source": "/admin/**",
        "function": "api"
      },
      {
        "source": "/candidate/**",
        "function": "api"
      },
      {
        "source": "/addit/**",
        "function": "api"
      },
      {
        "source": "/download/**",
        "function": "api"
      },
      {
        "source": "/api/ripplehire/**",
        "function": "ripplehire"
      },
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "/blog/**",
        "function": "api"
      },
      {
        "source": "/recruiterstats/**",
        "function": "api"
      },
      {
        "source": "/clientspocstats/**",
        "function": "api"
      },
      {
        "source": "/positionstats/**",
        "function": "api"
      },
      {
        "source": "/dashboardstats/**",
        "function": "api"
      },
      {
        "source": "/candidatestats/**",
        "function": "api"
      },
      {
        "source": "/clientstats/**",
        "function": "api"
      },
      {
        "source": "/vendor/**",
        "function": "api"
      },
      {
        "source": "/activity/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "Backend",
      "codebase": "default",
      "runtime": "nodejs20",
      "secrets": [
        "EMAIL",
        "PASSW",
        "SECKEY",
        "LINKEDIN_CLIENT_ID",
        "LINKEDIN_CLIENT_SECRET",
        "LINKEDIN_REDIRECT_URI",
        "BREVO_SMTP_HOST",
        "BREVO_SMTP_PORT",
        "BREVO_SMTP_USER",
        "BREVO_SMTP_PASS",
        "BREVO_API_KEY",
        "FRONTURL",
        "ANTHROPIC_API_KEY"
      ],
      "ignore": [
        "node_modules",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        ".env",
        ".env.*",
        "serviceAccountKey.json",
        "login_diagnostic.js"
      ]
    }
  ],
  "emulators": {
    "apphosting": {
      "port": 5000,
      "rootDirectory": "./",
      "startCommand": "npm run dev"
    },
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "database": {
      "port": 9000
    },
    "hosting": {
      "port": 5000
    },
    "pubsub": {
      "port": 8085
    },
    "storage": {
      "port": 9119
    },
    "eventarc": {
      "port": 9299
    },
    "dataconnect": {
      "port": 5004,
      "dataDir": "dataconnect/.dataconnect/pgliteData"
    },
    "tasks": {
      "port": 4173
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}