# Copy each KEY into Hostinger hPanel -> Node.js app -> Environment variables.
# Never commit real values.
NODE_ENV=production
FIREBASE_SERVICE_ACCOUNT=
FRONTURL=https://www.recruiterv.com
SECKEY=
EMAIL=
PASSW=
BREVO_API_KEY=
# Optional: send through a Hostinger mailbox instead of Brevo. Brevo is kept as
# automatic fallback when BREVO_API_KEY is also set.
# MAIL_DRIVER=smtp
# MAIL_SMTP_HOST=smtp.hostinger.com
# MAIL_SMTP_PORT=465
# MAIL_SMTP_USER=noreply@recruiterv.com
# MAIL_SMTP_PASS=
BREVO_SMTP_HOST=
BREVO_SMTP_PORT=
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
RESEND_API_KEY=
GMAIL_REPLY_USER=
GMAIL_REPLY_PASS=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_6MONTH=
RAZORPAY_PLAN_1YEAR=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
